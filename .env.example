# Copy this file to .env and configure a private first-account password locally.
# Keep .env private; never commit credentials.
RELAY_FALKORDB_HOST=127.0.0.1
RELAY_FALKORDB_PORT=6379
RELAY_FALKORDB_GRAPH=relay_demo
RELAY_CHECKPOINT_PATH=.data/checkpoints.sqlite
RELAY_DATA_DIR=.data
RELAY_BOOTSTRAP_ADMIN_LOGIN=owner
# At least 16 characters. Used once when no accounts exist; never resets an account.
RELAY_ACCESS_PASSWORD=
# Durable development storage. Explicit setup is documented in docs/persistence.md.
RELAY_STORAGE_MODE=persistent

# Optional Groq API credential. Without it, Relay uses labelled deterministic
# demo reasoning while all graph queries, memory, and actions still use FalkorDB.
RELAY_MODEL_API_KEY=
RELAY_MODEL_BASE_URL=https://api.groq.com/openai/v1
RELAY_MODEL=openai/gpt-oss-20b
